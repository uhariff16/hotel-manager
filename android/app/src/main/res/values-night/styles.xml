<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="bottomSheetDialogTheme">@style/DarkBottomSheetDialog</item>
        <item name="alertDialogTheme">@style/DarkAlertDialog</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="bottomSheetDialogTheme">@style/DarkBottomSheetDialog</item>
        <item name="alertDialogTheme">@style/DarkAlertDialog</item>
    </style>

    <style name="DarkBottomSheetDialog" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/DarkBottomSheet</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="DarkBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">#121212</item>
    </style>

    <style name="DarkAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">#121212</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
    </style>
</resources>
